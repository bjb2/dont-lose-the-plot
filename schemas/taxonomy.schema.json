{
  "$id": "https://dont-lose-the-plot.dev/schemas/taxonomy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "categories": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "attributes": {
            "additionalProperties": {
              "additionalProperties": false,
              "properties": {
                "description": { "type": "string" },
                "required": { "default": false, "type": "boolean" },
                "target": { "type": "string" },
                "type": {
                  "enum": ["string", "number", "boolean", "string-list", "entity-ref", "object"],
                  "type": "string"
                }
              },
              "required": ["type", "required"],
              "type": "object"
            },
            "default": {},
            "propertyNames": { "type": "string" },
            "type": "object"
          },
          "definition": { "minLength": 1, "type": "string" },
          "exclude": { "default": [], "items": { "type": "string" }, "type": "array" },
          "folder": { "minLength": 1, "type": "string" },
          "id": { "pattern": "^[a-z][a-z0-9-]*$", "type": "string" },
          "include": { "default": [], "items": { "type": "string" }, "type": "array" },
          "labels": {
            "additionalProperties": false,
            "properties": {
              "plural": { "minLength": 1, "type": "string" },
              "singular": { "minLength": 1, "type": "string" }
            },
            "required": ["singular", "plural"],
            "type": "object"
          },
          "pageTemplate": { "default": "entity", "type": "string" },
          "relations": { "default": [], "items": { "type": "string" }, "type": "array" },
          "tags": { "default": [], "items": { "type": "string" }, "type": "array" }
        },
        "required": [
          "id",
          "labels",
          "definition",
          "include",
          "exclude",
          "tags",
          "attributes",
          "relations",
          "folder",
          "pageTemplate"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "passageKinds": { "default": ["quote"], "items": { "type": "string" }, "type": "array" },
    "relationVocabulary": { "default": [], "items": { "type": "string" }, "type": "array" },
    "schemaVersion": { "const": 1, "type": "number" }
  },
  "required": ["schemaVersion", "categories", "passageKinds", "relationVocabulary"],
  "type": "object"
}
