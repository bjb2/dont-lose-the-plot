{
  "$id": "https://dont-lose-the-plot.dev/schemas/passage.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "certainty": { "enum": ["explicit", "inferred", "unresolved"], "type": "string" },
    "complete": { "type": "boolean" },
    "context": { "type": "string" },
    "entityIds": { "items": { "type": "string" }, "type": "array" },
    "id": { "type": "string" },
    "kind": { "type": "string" },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "excerpt": { "type": "string" },
        "locator": { "type": "string" },
        "segmentId": { "type": "string" },
        "segmentOrdinal": { "exclusiveMinimum": 0, "maximum": 9007199254740991, "type": "integer" },
        "sourceId": { "type": "string" }
      },
      "required": ["sourceId", "segmentId", "segmentOrdinal", "locator"],
      "type": "object"
    },
    "significance": { "type": "string" },
    "speakerId": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "text": { "type": "string" },
    "title": { "type": "string" }
  },
  "required": [
    "id",
    "title",
    "kind",
    "speakerId",
    "text",
    "context",
    "significance",
    "entityIds",
    "complete",
    "certainty",
    "provenance"
  ],
  "type": "object"
}
